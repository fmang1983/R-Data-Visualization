split_the_data <- function(data,percentage)
{
ls <- list()
split <- nrow(data)*percentage
ls <- append(ls, as.data.frame(data[1:split,]))
ls <- append(ls, as.data.frame(data[split:nrow(data),]))
return(ls)
}
